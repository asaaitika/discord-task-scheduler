# =============================================================================
# Discord Task Scheduler - Environment Configuration
# =============================================================================
# This file contains environment variables for the entire application.
# Copy this file to .env and update the values as needed.
#
# For backend-specific config, see: backend/.env.example
# For frontend-specific config, see: frontend/.env.example
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=discord_scheduler

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=3001
PORT=3001
NODE_ENV=development

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# -----------------------------------------------------------------------------
# API Authentication
# -----------------------------------------------------------------------------
# Generate a secure API key using: cd backend && npx ts-node scripts/generate-api-key.ts
API_KEY=test-api-key-12345
AUTH_ENABLED=true
API_KEY_HEADER=x-api-key

# Optional: Multiple keys (comma-separated)
# API_KEYS=key1,key2,key3

# -----------------------------------------------------------------------------
# TypeORM Configuration
# -----------------------------------------------------------------------------
TYPEORM_LOGGING=true

# -----------------------------------------------------------------------------
# Retry Configuration
# -----------------------------------------------------------------------------
# Configure retry behavior for failed Discord webhook notifications
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# -----------------------------------------------------------------------------
# Discord Configuration (Optional)
# -----------------------------------------------------------------------------
# For testing Discord webhook notifications
# Get webhook URL from: Discord Server Settings > Integrations > Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
