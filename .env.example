# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=discord_scheduler

# Backend Configuration
BACKEND_PORT=3001
PORT=3001

# Frontend Configuration
FRONTEND_PORT=3000

# API Authentication
# Generate a secure API key using: ts-node backend/scripts/generate-api-key.ts
API_KEY=your-secret-api-key-here
# Optional: Multiple keys (comma-separated)
# API_KEYS=key1,key2,key3
# Optional: Disable auth for development
# AUTH_ENABLED=true
# Optional: Custom header name
# API_KEY_HEADER=x-api-key

# TypeORM Migration Settings
# Optional: Enable TypeORM logging
# TYPEORM_LOGGING=false

# Retry Configuration
# Optional: Configure retry behavior
# MAX_RETRY_ATTEMPTS=3
# RETRY_INITIAL_DELAY_MS=1000
# RETRY_MAX_DELAY_MS=30000

# Environment
NODE_ENV=development
